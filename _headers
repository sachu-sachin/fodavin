# Cloudflare Pages response headers (ignored by GitHub Pages).
# CSS and JS are referenced with ?v=<version>, so they can be cached for a year.
# When you replace an image or font, give the new file a new name (or bump ?v=) so visitors get the new one.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/admin/*
  X-Robots-Tag: noindex

/_drafts/*
  X-Robots-Tag: noindex
